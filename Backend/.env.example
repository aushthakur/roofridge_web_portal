# ==============================================================================
# ROOF RIDGE BACKEND — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas Cluster URI or local mongodb:// connection)
MONGO_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/?appName=roofridge

# JWT Authentication Secret Key (Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace_with_a_secure_random_string_32_chars_min

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# SMS Gateway Options
# ------------------------------------------------------------------------------
# Enable simulated OTP logging in console & API response for free staging demos:
ALLOW_DEV_OTP=true

# Option A: Fast2SMS (Free trial/credits for Indian numbers: https://www.fast2sms.com)
FAST2SMS_API_KEY=

# Option B: Twilio (Production paid credentials)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
