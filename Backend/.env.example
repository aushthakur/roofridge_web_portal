# ==============================================================================
# ROOF RIDGE BACKEND — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas Cluster URI or local mongodb:// connection)
MONGO_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/?appName=roofridge

# JWT Authentication Secret Key
JWT_SECRET=replace_with_a_secure_random_string_32_chars_min

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Twilio SMS Gateway (Leave placeholder for dev fallback OTP: 1234)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
