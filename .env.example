# ==============================================================================
# ROOF RIDGE SUPERAPP — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Copy this file to .env in respective project subdirectories
# and replace placeholder values with your secure production credentials.
# NEVER commit real credentials, passwords, or tokens into version control.
# ==============================================================================

# ── BACKEND CONFIGURATION (Backend/.env) ──────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas Cluster URI or local mongodb:// connection)
# Note: In development/test mode, if MONGO_URI is omitted, the backend falls back
# to an embedded in-memory database with seed data for rapid local evaluation.
# In PRODUCTION (NODE_ENV=production), a persistent MONGO_URI is STRICTLY MANDATORY.
# Ephemeral in-memory fallback is refused by design to prevent silent data loss.
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_URL>/roofridge?retryWrites=true&w=majority

# JWT Authentication Secret Key (Generate a secure 64+ char random string)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Twilio SMS Gateway for OTP
# Note: In development/test mode, dev OTP 1234 / 123456 is supported.
# In PRODUCTION (NODE_ENV=production), dev OTP bypass is refused; an active SMS gateway is required.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── FRONTEND PORTAL (Frontend/.env) ──────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── ADMIN PANEL (Admin/.env) ──────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1
